---
import type { Project } from '../data/site';
const { project } = Astro.props as { project: Project };
---

{project.image ? (
  <img src={project.image} alt={`ภาพหน้าจอ ${project.name}`} loading="lazy" width="1280" height="800"
    class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]" />
) : (
  <div class="flex h-full flex-col bg-[var(--term-bg)] p-5 font-mono text-[12.5px] leading-relaxed text-[var(--term-fg)] sm:text-sm">
    <div class="mb-4 flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    </div>
    <p><span class="text-[#2dd4bf]">$</span> curl -X POST /api/bookings \</p>
    <p class="pl-4 opacity-70">-d '&#123;"room_id": 12, "nights": 2&#125;'</p>
    <p class="mt-3 text-[#fbbf24]">HTTP/1.1 201 Created</p>
    <p class="opacity-80">&#123;</p>
    <p class="pl-4"><span class="text-[#93c5fd]">"id"</span>: <span class="text-[#fbbf24]">4821</span>,</p>
    <p class="pl-4"><span class="text-[#93c5fd]">"status"</span>: <span class="text-[#86efac]">"confirmed"</span>,</p>
    <p class="pl-4"><span class="text-[#93c5fd]">"cached"</span>: <span class="text-[#fbbf24]">true</span></p>
    <p class="opacity-80">&#125;</p>
    <p class="mt-auto pt-4 text-xs opacity-50">axum · sqlx · redis · 🦀</p>
  </div>
)}
