---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
---

<li>
  <a href={`/blog/${post.id}`} class="group grid gap-1 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
    <time class="pt-1.5 font-mono text-xs text-muted">{formatDate(post.data.date)}</time>
    <div><h3 class="text-xl font-semibold transition group-hover:text-accent">
      {post.data.title}{post.data.draft && <span class="ml-2 text-xs text-muted">(draft)</span>}
    </h3>
    <p class="mt-1 text-sm text-muted">{post.data.description}</p></div>
  </a>
</li>
