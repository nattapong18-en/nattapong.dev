---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/posts';

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
---

<li>
  <a href={`/blog/${post.id}`} class="group block rounded-xl px-3 py-5 transition hover:bg-card sm:px-4">
    <time class="font-mono text-xs text-muted">{formatDate(post.data.date)}</time>
    <h3 class="mt-1 text-lg font-semibold group-hover:text-accent">
      {post.data.title}{post.data.draft && <span class="ml-2 text-xs text-muted">(draft)</span>}
    </h3>
    <p class="mt-1 text-sm text-muted">{post.data.description}</p>
  </a>
</li>
