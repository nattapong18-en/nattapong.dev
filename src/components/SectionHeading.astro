---
const { index, eyebrow, title, subtitle } = Astro.props as { index: string; eyebrow: string; title: string; subtitle?: string };
---

<div class="reveal">
  <p class="font-mono text-xs tracking-wider text-accent uppercase">{index} — {eyebrow}</p>
  <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-xl text-muted">{subtitle}</p>}
</div>
