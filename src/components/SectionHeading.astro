---
const { index, eyebrow, title } = Astro.props as { index: string; eyebrow: string; title: string };
---

<div class="reveal flex items-baseline gap-6 border-b border-line pb-6">
  <p class="w-10 shrink-0 font-mono text-xs text-accent">{index}</p>
  <div>
    <p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">{eyebrow}</p>
    <h2 class="mt-4 text-4xl leading-[1.25] font-semibold tracking-tight sm:text-6xl">{title}</h2>
  </div>
</div>
