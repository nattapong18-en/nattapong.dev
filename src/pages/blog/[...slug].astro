---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} — nattapong.dev`} description={post.data.description}>
  <article class="py-12">
    <a href="/blog" class="text-sm text-muted hover:text-fg">← Blog</a>
    <h1 class="mt-6 text-3xl font-bold tracking-tight sm:text-4xl">{post.data.title}</h1>
    <p class="mt-3 font-mono text-xs text-muted">
      {formatDate(post.data.date)}{post.data.tags.map((t) => ` · #${t}`)}
    </p>
    <div class="prose mt-10">
      <Content />
    </div>
  </article>
</Layout>
