---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import PostItem from '../components/PostItem.astro';
import ProjectVisual from '../components/ProjectVisual.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, services, projects } from '../data/site';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---

<Layout>
  <!-- Hero -->
  <section class="hero-bg border-b border-line">
    <div class="mx-auto grid max-w-5xl items-center gap-12 px-4 pt-16 pb-20 sm:px-6 md:grid-cols-[1.15fr_1fr] md:pt-24 md:pb-28">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-card/70 px-3 py-1 text-xs font-medium text-muted backdrop-blur">
          <span class="pulse h-2 w-2 rounded-full bg-accent"></span>{site.status}
        </p>
        <h1 class="mt-6 text-4xl leading-[1.15] font-bold tracking-tight sm:text-6xl">
          สวัสดีครับ<br />ผม <span class="text-gradient">{site.name}</span>
        </h1>
        <p class="mt-5 max-w-md text-lg leading-relaxed text-muted">{site.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#contact" class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 text-sm font-semibold text-on-accent shadow-lg shadow-accent/20 transition hover:-translate-y-0.5">
            จ้างงาน / ติดต่อ <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="#projects" class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5">
            ดูผลงาน
          </a>
        </div>
      </div>

      <!-- terminal -->
      <div class="relative">
        <div class="absolute -inset-4 -z-10 rounded-3xl bg-gradient-to-br from-accent/25 to-accent-2/20 blur-2xl"></div>
        <div class="overflow-hidden rounded-2xl border border-white/10 bg-[var(--term-bg)] font-mono text-[13px] leading-relaxed text-[var(--term-fg)] shadow-2xl">
          <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 text-xs opacity-50">~/nattapong — zsh</span>
          </div>
          <div class="space-y-1 p-5">
            <p><span class="text-[#2dd4bf]">❯</span> whoami</p>
            <p class="opacity-80">Nattapong · Computer Engineering ปี 4</p>
            <p class="pt-2"><span class="text-[#2dd4bf]">❯</span> ls ./stack</p>
            <p class="flex flex-wrap gap-x-3 text-[#fbbf24]">
              {site.skills.slice(0, 6).map((s) => <span>{s}</span>)}
            </p>
            <p class="pt-2"><span class="text-[#2dd4bf]">❯</span> cat now.txt</p>
            <p class="opacity-80">สร้าง IoT + web · เริ่มทำ open source</p>
            <p class="pt-2"><span class="text-[#2dd4bf]">❯</span> <span class="cursor"></span></p>
          </div>
        </div>
      </div>
    </div>

    <!-- stats -->
    <div class="border-t border-line bg-card/40">
      <dl class="mx-auto grid max-w-5xl grid-cols-3 divide-x divide-line px-4 sm:px-6">
        {site.stats.map((s) => (
          <div class="flex flex-col-reverse px-2 py-6 text-center sm:px-6">
            <dt class="mt-1 text-xs text-muted sm:text-sm">{s.label}</dt>
            <dd class="text-xl font-bold tracking-tight sm:text-3xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <!-- Services -->
    <section id="work" class="scroll-mt-20 py-24">
      <SectionHeading index="01" eyebrow="services" title="รับงาน" subtitle="งานขนาดเล็กถึงกลาง คุยรายละเอียดและประเมินราคาให้ฟรี" />
      <div class="mt-12 grid gap-4 sm:grid-cols-2">
        {services.map((s) => (
          <div class="reveal group rounded-2xl border border-line bg-card p-6 transition hover:-translate-y-1 hover:border-accent/50 hover:shadow-xl hover:shadow-accent/5">
            <div class="grid h-11 w-11 place-items-center rounded-xl bg-accent/10 text-accent transition group-hover:bg-accent group-hover:text-on-accent">
              <Icon name={s.icon} />
            </div>
            <h3 class="mt-5 text-lg font-semibold">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="scroll-mt-20 border-t border-line py-24">
      <SectionHeading index="02" eyebrow="selected work" title="ผลงาน" subtitle="โปรเจกต์ที่ทำระหว่างเรียน ตั้งแต่ hardware ไปจนถึง backend และหน้าเว็บ" />

      <div class="mt-12 space-y-6">
        {featured.map((p, i) => (
          <article class="reveal group grid overflow-hidden rounded-3xl border border-line bg-card transition hover:border-accent/50 md:grid-cols-2">
            <div class:list={['aspect-[16/10] overflow-hidden border-line max-md:border-b md:aspect-auto md:min-h-72', i % 2 ? 'md:order-2 md:border-l' : 'md:border-r']}>
              <ProjectVisual project={p} />
            </div>
            <div class="flex flex-col p-6 sm:p-8">
              <p class="font-mono text-xs text-muted">0{i + 1}</p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight">{p.name}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{p.desc}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {p.tags.map((t) => <li class="rounded-full bg-bg-2 px-3 py-1 font-mono text-xs text-muted">{t}</li>)}
              </ul>
              <div class="mt-6 flex flex-wrap gap-3 text-sm font-semibold">
                {p.demo && (
                  <a href={p.demo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-fg px-4 py-2 text-bg hover:opacity-90">
                    Live demo <Icon name="arrow" class="h-3.5 w-3.5" />
                  </a>
                )}
                <a href={p.href} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-line px-4 py-2 hover:bg-bg-2">
                  <Icon name="github" class="h-4 w-4" /> Code
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {others.map((p) => (
          <a href={p.href} target="_blank" rel="noopener" class="reveal group flex flex-col rounded-2xl border border-line bg-card p-6 transition hover:-translate-y-1 hover:border-accent/50">
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-semibold group-hover:text-accent">{p.name}</h3>
              <Icon name="arrow" class="h-4 w-4 shrink-0 text-muted transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" />
            </div>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{p.desc}</p>
            <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
              {p.tags.map((t) => <li class="font-mono text-xs text-muted">#{t}</li>)}
            </ul>
          </a>
        ))}
      </div>

      <a href="https://github.com/nattapong18-en?tab=repositories" target="_blank" rel="noopener" class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-muted hover:text-fg">
        <Icon name="github" class="h-4 w-4" /> ดูทั้งหมดบน GitHub →
      </a>
    </section>

    {posts.length > 0 && (
      <section class="border-t border-line py-24">
        <div class="flex items-end justify-between gap-4">
          <SectionHeading index="03" eyebrow="writing" title="Blog" />
          <a href="/blog" class="shrink-0 text-sm font-medium text-muted hover:text-fg">ทั้งหมด →</a>
        </div>
        <ul class="mt-10 divide-y divide-line border-y border-line">
          {posts.slice(0, 3).map((post) => <PostItem post={post} />)}
        </ul>
      </section>
    )}

    <!-- Contact -->
    <section id="contact" class="scroll-mt-20 pb-24">
      <div class="reveal relative overflow-hidden rounded-3xl bg-[var(--term-bg)] px-6 py-14 text-center text-[var(--term-fg)] sm:px-12 sm:py-20">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(500px_260px_at_20%_0%,rgb(45_212_191/0.25),transparent_70%),radial-gradient(420px_240px_at_90%_100%,rgb(251_191_36/0.18),transparent_70%)]"></div>
        <div class="relative">
          <p class="font-mono text-xs tracking-wider text-[#2dd4bf] uppercase">04 — contact</p>
          <h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-5xl">มีไอเดียอยากให้ช่วยทำ?</h2>
          <p class="mx-auto mt-4 max-w-md opacity-70">ไม่ว่าจะเป็นเว็บร้าน ระบบเล็กๆ หรืออยากชวนทำ open source ด้วยกัน ทักมาคุยได้เลยครับ</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3">
            {site.email && (
              <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 rounded-full bg-[#2dd4bf] px-6 py-3 text-sm font-semibold text-[#06201d] hover:opacity-90">
                <Icon name="mail" class="h-4 w-4" /> {site.email}
              </a>
            )}
            {site.links.map((l, i) => (
              <a href={l.href} target="_blank" rel="noopener"
                class:list={['inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5',
                  !site.email && i === 0 ? 'bg-[#2dd4bf] text-[#06201d]' : 'border border-white/15 hover:bg-white/5']}>
                {l.label === 'GitHub' && <Icon name="github" class="h-4 w-4" />}{l.label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
